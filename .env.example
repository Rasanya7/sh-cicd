# ===================================================
# SH-CICD Environment Configuration
# ===================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-sh-cicd-key-2026

# GitHub Integration (Optional for live GitHub PRs; Demo Mode works without this)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_REPO=username/repository-name
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key_here

# AI / LLM Provider Configuration
# Supported options: 'demo' (built-in offline AI), 'gemini', 'openai'
AI_PROVIDER=demo
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# System Mode: set to 'true' to run fully offline without GitHub/LLM credentials
DEMO_MODE=true
